# Copy to .env. Empty API URL selects a local host automatically:
# web / iOS with npm run ios: localhost; Android emulator: 10.0.2.2.
# Phone on the same Wi-Fi: set http://YOUR_COMPUTER_LAN_IP:3000/api
# and run npm run start:lan. All EXPO_PUBLIC_* values are visible in the app.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_PORT=3000
EXPO_PUBLIC_API_PATH=/api
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# Socket.IO uses the API gateway origin on port 3000 by default.
EXPO_PUBLIC_SOCKET_URL=
EXPO_PUBLIC_SOCKET_PATH=/socket.io

# Optional: own public Google OAuth client ID for a custom native build.
# Leave blank for email/password + OTP in Expo Go or web.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
