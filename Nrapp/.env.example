# Full API URL used by the app. Copy this file to .env.local and adjust it.
EXPO_PUBLIC_API_URL=http://YOUR_GATEWAY_HOST:3000/api

# Public OAuth client ID used by Google Sign-In to obtain the backend ID token.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# Optional overrides
# EXPO_PUBLIC_API_TIMEOUT_MS=10000
# Optional: only needed when Socket.IO does not use the API gateway origin.
# EXPO_PUBLIC_SOCKET_URL=http://YOUR_CHAT_SOCKET_HOST:5002
# EXPO_PUBLIC_SOCKET_PATH=/socket.io
# EXPO_PUBLIC_API_PORT=3000
# EXPO_PUBLIC_API_PATH=/api
