# Được tạo tự động bởi npm run setup tại thư mục gốc; không commit file .env.
NODE_ENV=development
PORT=5001

# Mailpit: mở http://localhost:8025 để lấy OTP. Không gửi ra email thật.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_AUTH=false
SMTP_CONNECTION_TIMEOUT_MS=3000
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NRApp Local <noreply@nrapp.local>"

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=nrapp_dev
RABBITMQ_PASSWORD=__RABBITMQ_PASSWORD__
MAIL_QUEUE=send-otp
MAIL_PREFETCH=5
MAIL_RETRY_QUEUE=send-otp.retry
MAIL_DEAD_LETTER_QUEUE=send-otp.dlq
MAIL_MAX_RETRIES=5
MAIL_RETRY_DELAY_MS=5000

# Log chỉ in ra terminal khi chạy local.
LOG_LEVEL=info
LOG_FORMAT=pretty
DEPLOYMENT_ENVIRONMENT=development
