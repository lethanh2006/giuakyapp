#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  on|off)
    ln -sfn \
      "/etc/nginx/snippets/nrapp-monitoring-${1}.conf" \
      /etc/nginx/snippets/nrapp-monitoring-access.conf
    nginx -t
    systemctl reload nginx
    echo "NRApp monitoring: ${1}"
    ;;
  *)
    echo "Dung: sudo nrapp-monitoring on|off"
    exit 1
    ;;
esac
