# Được tạo tự động bởi npm run setup tại thư mục gốc; không commit file .env.
NODE_ENV=development
PORT=5006
PAYMENT_DB_HOST=127.0.0.1
PAYMENT_DB_PORT=5433
PAYMENT_DB_USER=nrapp_payment
PAYMENT_DB_PASSWORD=__PAYMENT_POSTGRES_PASSWORD__
PAYMENT_DB_NAME=nrapp_payment
PAYMENT_DB_SSL=false
PAYMENT_DB_RUN_MIGRATIONS=true
PAYMENT_INTERNAL_SECRET=__PAYMENT_INTERNAL_SECRET__
PAYMENT_REQUIRE_SIGNATURE=true
PAYMENT_SIGNATURE_MAX_AGE_MS=300000

# Dữ liệu mẫu local để service khởi động; không kết nối Casso thật.
CASSO_WEBHOOK_SECRET=__CASSO_WEBHOOK_SECRET__
CASSO_WEBHOOK_PREVIOUS_SECRET=
CASSO_SIGNATURE_MAX_AGE_MS=0
CASSO_TIMEZONE_OFFSET=+07:00
VIETQR_BANK_ID=OCB
VIETQR_ACCOUNT_NUMBER=0000000000
VIETQR_ACCOUNT_NAME=NRAPP LOCAL DEMO
VIETQR_TEMPLATES=compact2
VIETQR_DESCRIPTION_PREFIX=NRAPP LOCAL
PAYMENT_CODE_PREFIX=NRP
PAYMENT_INTENT_TTL_MINUTES=15
PAYMENT_EXPIRY_INTERVAL_MS=60000
PAYMENT_OUTBOX_INTERVAL_MS=1000
PAYMENT_OUTBOX_MAX_ATTEMPTS=0
PAYMENT_PUBLIC_ENTRY_LOG_REJECTIONS=false

Rabbitmq_Host=127.0.0.1
Rabbitmq_Port=5672
Rabbitmq_Username=nrapp_dev
Rabbitmq_Password=__RABBITMQ_PASSWORD__

# Log chỉ in ra terminal khi chạy local.
LOG_LEVEL=info
LOG_FORMAT=pretty
DEPLOYMENT_ENVIRONMENT=development
