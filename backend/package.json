{
  "name": "nrapp-backend",
  "private": true,
  "scripts": {
    "setup": "node ../scripts/setup-local.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:apps": "node scripts/dev.mjs --skip-infra",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs --tail=100 -f"
  },
  "engines": {
    "node": ">=20.19"
  }
}
