# Được tạo tự động bởi npm run setup tại thư mục gốc; không commit file .env.
NODE_ENV=development
PORT=4000
# npm run setup lấy hai giá trị này từ backend/.env.
MONGO_URL=__MONGO_URL__
MONGO_DB_NAME=__MONGO_DB_NAME__
REDIS_URL=redis://127.0.0.1:6379
USER_SERVICE=http://127.0.0.1:5000
JWT_SECRET=__JWT_SECRET__
AUTH_INTERNAL_SECRET=__AUTH_INTERNAL_SECRET__
AUTH_SIGNATURE_MAX_AGE_MS=300000
# Tùy chọn; đăng nhập email/OTP không cần Google.
GOOGLE_WEB_CLIENT_ID=

Rabbitmq_Host=127.0.0.1
Rabbitmq_Port=5672
Rabbitmq_Username=nrapp_dev
Rabbitmq_Password=__RABBITMQ_PASSWORD__

# Log chỉ in ra terminal khi chạy local.
LOG_LEVEL=info
LOG_FORMAT=pretty
DEPLOYMENT_ENVIRONMENT=development
