# Được tạo tự động bởi npm run setup tại thư mục gốc; không commit file .env.
NODE_ENV=development
PORT=5005
MONGO_URL=mongodb://127.0.0.1:27017/nrapp?replicaSet=rs0&directConnection=true
MONGO_DB_NAME=nrapp
REDIS_URL=redis://127.0.0.1:6379
CANTEEN_INTERNAL_SECRET=__CANTEEN_INTERNAL_SECRET__
CANTEEN_REQUIRE_SIGNATURE=true
CANTEEN_SIGNATURE_MAX_AGE_MS=300000

# Log chỉ in ra terminal khi chạy local.
LOG_LEVEL=info
LOG_FORMAT=pretty
DEPLOYMENT_ENVIRONMENT=development
