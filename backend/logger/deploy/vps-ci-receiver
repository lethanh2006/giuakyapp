#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

readonly BACKEND_DIR="/opt/nrapp/backend"
readonly DEPLOY_ROOT="/opt/nrapp/cd"
readonly DC="/home/deploy/bin/dc"
readonly MAX_IMAGE_MIB=512

fail() {
  printf 'CD_ERROR: %s\n' "$*" >&2
  exit 1
}

log() {
  printf '[%s] %s\n' "$(date --iso-8601=seconds)" "$*"
}

readonly allowed_service="${1:-}"

case "$allowed_service" in
  gateway|auth|user|mail|chat|todo|workschedule|canteen) ;;
  *) fail "Forced command chua gan service hop le" ;;
esac

read -r action service revision extra <<<"${SSH_ORIGINAL_COMMAND:-}"

[[ "$action" == "deploy" ]] \
  || fail "Lenh SSH khong hop le"
[[ -z "${extra:-}" ]] \
  || fail "Lenh SSH co tham so du"
[[ "$revision" =~ ^[0-9a-f]{40}$ ]] \
  || fail "Git SHA khong hop le"

case "$service" in
  gateway|auth|user|mail|chat|todo|workschedule|canteen) ;;
  *) fail "Service khong duoc phep deploy: $service" ;;
esac

[[ "$service" == "$allowed_service" ]] \
  || fail "SSH key nay chi duoc deploy service $allowed_service"

[[ -x "$DC" ]] \
  || fail "Khong tim thay helper dc"
[[ -f "$BACKEND_DIR/compose.yaml" ]] \
  || fail "Khong tim thay compose.yaml tren VPS"
[[ -f "$BACKEND_DIR/compose.vps.yaml" ]] \
  || fail "Khong tim thay compose.vps.yaml tren VPS"

mkdir -p "$DEPLOY_ROOT/incoming"

archive="$(mktemp \
  "$DEPLOY_ROOT/incoming/${service}-${revision}.XXXXXX.tar.gz")"

cleanup() {
  rm -f -- "$archive"
}
trap cleanup EXIT

log "Nhan image $service tai revision $revision"

timeout 1800 python3 -c '
import sys
import zlib

archive, max_mib = sys.argv[1:]
limit = int(max_mib) * 1024 * 1024
decoder = zlib.decompressobj(16 + zlib.MAX_WBITS)
received = 0

with open(archive, "wb") as output:
    while received < limit:
        chunk = sys.stdin.buffer.read(min(1024 * 1024, limit - received))
        if not chunk:
            break
        output.write(chunk)
        received += len(chunk)
        decoder.decompress(chunk)
        if decoder.eof:
            break

if not decoder.eof:
    raise SystemExit("CD_ERROR: khong doc duoc ket thuc gzip archive")
' "$archive" "$MAX_IMAGE_MIB"

[[ -s "$archive" ]] \
  || fail "Image archive rong"
gzip -t "$archive" \
  || fail "Image archive gzip bi hong"

readonly image="nrapp/${service}:vps-lab-001"
readonly rollback_image="nrapp/${service}:rollback"

python3 - "$archive" "$image" <<'PY'
import json
import sys
import tarfile

archive, expected = sys.argv[1:]

with tarfile.open(archive, mode="r:gz") as image_tar:
    try:
        manifest_file = image_tar.extractfile("manifest.json")
    except KeyError as error:
        raise SystemExit("CD_ERROR: archive khong co manifest.json") from error
    if manifest_file is None:
        raise SystemExit("CD_ERROR: khong doc duoc manifest.json")
    manifest = json.load(manifest_file)

repo_tags = [
    tag
    for item in manifest
    for tag in (item.get("RepoTags") or [])
]

if len(manifest) != 1 or repo_tags != [expected]:
    raise SystemExit(
        "CD_ERROR: archive phai chua dung mot image co tag " + expected
    )

print("IMAGE_MANIFEST: OK")
PY

# Nhan va kiem tra cac archive song song. Chi khoa doan thay image/container,
# de nhieu workflow khong chiem ket noi SSH trong luc cho workflow khac upload.
exec 9>"$DEPLOY_ROOT/deploy.lock"
flock -w 3600 9 \
  || fail "Khong lay duoc deployment lock sau 60 phut"

had_previous=false
previous_id=""

if previous_id="$(docker image inspect \
  --format '{{.Id}}' "$image" 2>/dev/null)"; then
  had_previous=true
  docker image rm "$rollback_image" >/dev/null 2>&1 || true
  docker image tag "$image" "$rollback_image"
  log "Da luu image cu thanh $rollback_image"
fi

gzip -dc "$archive" | docker image load

new_id="$(docker image inspect --format '{{.Id}}' "$image")"
architecture="$(docker image inspect --format '{{.Architecture}}' "$image")"

if [[ "$architecture" != "amd64" ]]; then
  if [[ "$had_previous" == true ]]; then
    docker image tag "$rollback_image" "$image"
  fi
  fail "Image sai kien truc: $architecture"
fi

deploy_service() {
  local container_id running_id

  cd "$BACKEND_DIR"

  "$DC" --profile app up -d \
    --no-deps \
    --no-build \
    --pull never \
    --force-recreate \
    --wait \
    --wait-timeout 300 \
    "$service"

  container_id="$("$DC" --profile app ps -q "$service")"
  [[ -n "$container_id" ]] || return 1

  running_id="$(docker inspect --format '{{.Image}}' "$container_id")"
  [[ "$running_id" == "$(docker image inspect --format '{{.Id}}' "$image")" ]]
}

log "Bat dau cap nhat container $service"

if deploy_service; then
  printf '%s\t%s\t%s\t%s\n' \
    "$(date --iso-8601=seconds)" \
    "$service" \
    "$revision" \
    "$new_id" \
    >>"$DEPLOY_ROOT/history.tsv"

  log "DEPLOY_OK: $service tai $revision"
  "$DC" --profile app ps "$service"
  exit 0
fi

log "Deploy that bai; in 200 dong log gan nhat"
"$DC" --profile app logs --no-color --tail 200 "$service" || true

if [[ "$had_previous" == true ]]; then
  log "Rollback $service ve image $previous_id"
  docker image tag "$rollback_image" "$image"

  if deploy_service; then
    log "ROLLBACK_OK: $service"
  else
    "$DC" --profile app logs --no-color --tail 200 "$service" || true
    fail "Rollback $service cung that bai"
  fi
else
  log "Khong co image cu de rollback"
fi

fail "Deploy $service that bai"
