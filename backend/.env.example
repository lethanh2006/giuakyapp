# Được tạo tự động bởi npm run setup tại thư mục gốc; không commit file .env.
NODE_ENV=development
COMPOSE_PROJECT_NAME=nrapp-local-dev

# Secret sinh riêng trên từng máy, dùng chung giữa các service.
JWT_SECRET=__JWT_SECRET__
AUTH_INTERNAL_SECRET=__AUTH_INTERNAL_SECRET__
USER_INTERNAL_SECRET=__USER_INTERNAL_SECRET__
CHAT_INTERNAL_SECRET=__CHAT_INTERNAL_SECRET__
TODO_INTERNAL_SECRET=__TODO_INTERNAL_SECRET__
WORKSCHEDULE_INTERNAL_SECRET=__WORKSCHEDULE_INTERNAL_SECRET__
CANTEEN_INTERNAL_SECRET=__CANTEEN_INTERNAL_SECRET__
PAYMENT_INTERNAL_SECRET=__PAYMENT_INTERNAL_SECRET__
CASSO_WEBHOOK_SECRET=__CASSO_WEBHOOK_SECRET__

# MongoDB Atlas dev dùng chung cho cả nhóm; lấy mật khẩu từ người quản lý DB.
# Chỉ cần sửa Mongo tại backend/.env; runner truyền cấu hình cho cả 6 service.
MONGO_MODE=atlas
MONGO_URL=mongodb+srv://<db_username>:<db_password>@cluster0.nyzuk0s.mongodb.net/nrapp_dev?appName=Cluster0
MONGO_DB_NAME=nrapp_dev
# DNS cho runner dev để tránh lỗi querySrv của một số mạng; để trống dùng DNS hệ điều hành.
DEV_DNS_SERVERS=1.1.1.1,8.8.8.8
# Chỉ dùng cổng này khi chủ động đổi MONGO_MODE=local, MONGO_DB_NAME=nrapp_local.
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379
RABBITMQ_USER=nrapp_dev
RABBITMQ_PASSWORD=__RABBITMQ_PASSWORD__
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_UI_HOST_PORT=15672
PAYMENT_POSTGRES_USER=nrapp_payment
PAYMENT_POSTGRES_PASSWORD=__PAYMENT_POSTGRES_PASSWORD__
PAYMENT_POSTGRES_DB=nrapp_payment
PAYMENT_POSTGRES_HOST_PORT=5433
# OTP chỉ phát khi đăng nhập; xem tại http://localhost:8025 trên máy BE.
# Mailpit nhận thư local, không gửi đến Gmail thật.
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

# Node service chạy trực tiếp trên máy. Gateway mở cho thiết bị cùng mạng LAN.
GATEWAY_HOST_PORT=3000
AUTH_HOST_PORT=4000
USER_HOST_PORT=5000
MAIL_HOST_PORT=5001
CHAT_HOST_PORT=5002
TODO_HOST_PORT=5003
WORKSCHEDULE_HOST_PORT=5004
CANTEEN_HOST_PORT=5005
PAYMENT_HOST_PORT=5006

# Log chỉ in ra terminal khi chạy local.
LOG_LEVEL=info
LOG_FORMAT=pretty
DEPLOYMENT_ENVIRONMENT=development
