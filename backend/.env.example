# Sao chép file này thành .env trước khi chạy Docker Compose.
COMPOSE_PROJECT_NAME=nrapp-backend
# Chỉ dùng cho môi trường development local. Hãy đổi mật khẩu này.
RABBITMQ_USER=nrapp_dev
RABBITMQ_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# PostgreSQL riêng của Payment Service.
PAYMENT_POSTGRES_USER=nrapp_payment
PAYMENT_POSTGRES_PASSWORD=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_PASSWORD
PAYMENT_POSTGRES_DB=nrapp_payment

# pgAdmin web cho team (npm run pgadmin:up). Tài khoản quản trị riêng với DB.
# Chỉ dùng để tạo tài khoản lần đầu; đổi mật khẩu sau đó trong pgAdmin.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_TO_A_UNIQUE_LONG_RANDOM_PASSWORD
PGADMIN_HOST_PORT=5050

# Mỗi secret phải có ít nhất 32 ký tự. Hai đầu của từng kết nối phải dùng cùng giá trị.
CANTEEN_INTERNAL_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_CANTEEN_SECRET
PAYMENT_INTERNAL_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_PAYMENT_SECRET
USER_INTERNAL_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_USER_SECRET
CHAT_INTERNAL_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_CHAT_SECRET
TODO_INTERNAL_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_TODO_SECRET
WORKSCHEDULE_INTERNAL_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_WORKSCHEDULE_SECRET

# Gateway cần 0.0.0.0 nếu điện thoại thật truy cập qua mạng LAN.
GATEWAY_BIND_IP=0.0.0.0

# Có thể đổi các port host nếu máy đang bị trùng port.
GATEWAY_HOST_PORT=3000
AUTH_HOST_PORT=4000
USER_HOST_PORT=5000
MAIL_HOST_PORT=5001
CHAT_HOST_PORT=5002
TODO_HOST_PORT=5003
WORKSCHEDULE_HOST_PORT=5004
CANTEEN_HOST_PORT=5005
PAYMENT_HOST_PORT=5006
REDIS_HOST_PORT=6379
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_UI_HOST_PORT=15672
PAYMENT_POSTGRES_HOST_PORT=5433
