# Được tạo tự động bởi npm run setup tại thư mục gốc; không commit file .env.
NODE_ENV=development
PORT=3000
AUTH_SERVICE_URL=http://127.0.0.1:4000
USER_SERVICE_URL=http://127.0.0.1:5000
CHAT_SERVICE_URL=http://127.0.0.1:5002
TODO_SERVICE_URL=http://127.0.0.1:5003
WORKSCHEDULE_SERVICE_URL=http://127.0.0.1:5004
CANTEEN_SERVICE_URL=http://127.0.0.1:5005
PAYMENT_SERVICE_URL=http://127.0.0.1:5006
UPSTREAM_TIMEOUT_MS=10000

JWT_SECRET=__JWT_SECRET__
AUTH_INTERNAL_SECRET=__AUTH_INTERNAL_SECRET__
USER_INTERNAL_SECRET=__USER_INTERNAL_SECRET__
CHAT_INTERNAL_SECRET=__CHAT_INTERNAL_SECRET__
TODO_INTERNAL_SECRET=__TODO_INTERNAL_SECRET__
WORKSCHEDULE_INTERNAL_SECRET=__WORKSCHEDULE_INTERNAL_SECRET__
CANTEEN_INTERNAL_SECRET=__CANTEEN_INTERNAL_SECRET__
PAYMENT_INTERNAL_SECRET=__PAYMENT_INTERNAL_SECRET__
GATEWAY_AUTH_INTROSPECTION_CACHE_TTL_MS=1000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
TITLE_SWAGGER=NRApp Local Gateway
CONTENT_SWAGGER=API cho development local
VERSION_SWAGGER=1.0.0
ENDPOINT_SWAGGER=api-docs

# Log chỉ in ra terminal khi chạy local.
LOG_LEVEL=info
LOG_FORMAT=pretty
DEPLOYMENT_ENVIRONMENT=development
