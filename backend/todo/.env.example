# Được tạo tự động bởi npm run setup tại thư mục gốc; không commit file .env.
NODE_ENV=development
PORT=5003
# npm run setup lấy hai giá trị này từ backend/.env.
MONGO_URL=__MONGO_URL__
MONGO_DB_NAME=__MONGO_DB_NAME__
USER_SERVICE_URL=http://127.0.0.1:5000
USER_SERVICE_TIMEOUT_MS=3000
USER_INTERNAL_SECRET=__USER_INTERNAL_SECRET__
TODO_INTERNAL_SECRET=__TODO_INTERNAL_SECRET__
TODO_SIGNATURE_MAX_AGE_MS=300000

# Log chỉ in ra terminal khi chạy local.
LOG_LEVEL=info
LOG_FORMAT=pretty
DEPLOYMENT_ENVIRONMENT=development
